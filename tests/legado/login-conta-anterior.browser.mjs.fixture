    await waitFor(async()=>{try{return (await fs.stat(backupSeedPath)).size>0;}catch{return false;}},'Backup local baixado somente na pasta temporária dos testes');
    const backupSeed = JSON.parse(await fs.readFile(backupSeedPath, 'utf8'));
    assert.equal(backupSeed.registros.filter(r=>r.tipo==='aula').length, 4);
    assert.equal(backupSeed.registros.filter(r=>r.seedId==='sipa-recursos-agendamento-v1').length, 48);
    assert.deepEqual(backupSeed.creditos, JSON.parse(antesSeed).creditos);
    for(const sensivel of ['contas','senha','sessoes','token'])assert.equal(Object.hasOwn(backupSeed,sensivel),false);
    checks.push('Backup baixado contém reservas, recursos e créditos sem conta, senha ou sessão');
    await evaluate("window.confirm=()=>false;document.querySelector('#configurar-recursos-locais').open=true;document.querySelector('#remover-recursos-teste').click()");
    await waitFor(()=>evaluate("document.querySelector('[data-seed-retorno]').textContent.includes('Remoção cancelada') && !document.querySelector('#remover-recursos-teste').disabled"),'Confirmação negativa de remoção finalizada');
    await check("(await servico.registros()).filter(r=>r.seedId==='sipa-recursos-agendamento-v1').length===48",'Cancelar confirmação de limpeza preserva todos os recursos fictícios');
    await evaluate("window.confirm=()=>true;document.querySelector('#remover-recursos-teste').click()");
    await waitFor(()=>evaluate("document.querySelector('[data-seed-retorno]').textContent && !document.querySelector('#remover-recursos-teste').disabled && (await servico.registros()).filter(r=>r.seedId==='sipa-recursos-agendamento-v1').length<48"),'Limpeza controlada preservando dependências');
    await check("{const rs=await servico.registros(),aulas=rs.filter(r=>r.tipo==='aula');aulas.every(a=>rs.some(r=>r.id===a.instrutor)&&rs.some(r=>r.id===a.veiculo))&&rs.some(r=>r.id===veiculoDependencia.id)&&rs.filter(r=>r.seedId==='sipa-recursos-agendamento-v1').length>0}",'Limpeza conserva referências de reservas e vínculos de recurso manual');
    await check(`JSON.stringify((await servico.registros()).filter(r=>r.tipo==='aluno'||r.tipo==='aula'||r.id.startsWith('manual-preservar-seed-')))===${JSON.stringify(antesLimpezaSeed)} && JSON.stringify((await servico.backup()).creditos)===JSON.stringify(JSON.parse(${JSON.stringify(antesSeed)}).creditos) && (await servico.dadosAlunoLocal()).resumo.categorias.A.disponiveis===18`,'Limpeza não cancela aulas, não apaga alunos ou recursos manuais e não modifica créditos');
    await check("{const r=await servico.removerRecursosTeste();r.removidos===0&&r.preservados>0&&r.dependencias.length>0}",'Serviço informa dependências preservadas ao repetir limpeza');
    await check(`await new Promise((resolve,reject)=>{const r=indexedDB.open('sipa.dev.local.v1');r.onerror=()=>reject(r.error);r.onsuccess=()=>{const db=r.result,q=db.transaction('contas').objectStore('contas').getAll();q.onsuccess=()=>{resolve(JSON.stringify(q.result)===${JSON.stringify(contaAntesSeed)});db.close();};q.onerror=()=>reject(q.error);};})`,'Preparação e limpeza mantêm conta, senha derivada e identificação originais');
    await screenshot('recursos-ficticios-limpeza-dependencias.png');
    // Somente as quatro reservas de teste deste perfil são canceladas/removidas
    // para restaurar a fixture legada; a ferramenta do produto não exclui aulas.
    await evaluate("for(const a of (await servico.dadosAlunoLocal()).aulas){await servico.excluir(a.id);}await servico.excluir('manual-preservar-seed-i');await servico.excluir('manual-preservar-seed-v');window.limpezaFinal=await servico.removerRecursosTeste();true");
    await check("limpezaFinal.removidos>0 && limpezaFinal.preservados===0 && !(await servico.registros()).some(r=>r.seedId==='sipa-recursos-agendamento-v1') && (await servico.dadosAlunoLocal()).resumo.categorias.A.disponiveis===20 && (await servico.dadosAlunoLocal()).resumo.categorias.B.disponiveis===20",'Sem dependências a limpeza remove somente recursos gerados e preserva créditos e aluno');
    await check(`JSON.stringify(await servico.backup())===JSON.stringify({...JSON.parse(${JSON.stringify(antesSeed)}),registros:JSON.parse(${JSON.stringify(antesSeed)}).registros.filter(r=>!r.id.startsWith('manual-preservar-seed-'))}) && testCalls.length===0`,'Fixture final preservada integralmente após teste isolado sem chamadas à API');

    await send('Page.navigate',{url:origin+'/nivel-1-operador/html/operador-cfc.html'});
    await waitFor(()=>evaluate("location.pathname==='/login.html' && document.querySelector('#ambiente-teste')"),'Contexto aluno não abre operador');
    await check("!document.querySelector('#operador-conteudo') && testCalls.length===0",'Página local exige contexto correspondente e sessão válida');
    await preencher('#login-cpf','93541134780');await preencher('#login-password','135790');
    await evaluate("document.querySelector('#ambiente-teste').value='adm1'");await submeter('#login-form');
    await waitFor(()=>evaluate("location.pathname==='/nivel-1-operador/html/operador-cfc.html' && document.body?.dataset.sipaLocal==='adm1'"),'Operador local existente');
    await check("testCalls.length===0 && !document.querySelector('#operador-conteudo').hidden && document.querySelector('#operador-acesso').hidden",'ADM 1 abre painel existente sem API');
    await check("!document.body.textContent.includes('Aluno Exemplo') && localStorage['sipa.operador.demo.v2']==='legado-preservado'",'Demonstração antiga preservada e não carregada no contexto local');
    for(const secao of ['alunos','agenda','verificacoes','acessos','recursos','visao-geral']) {
        await evaluate(`document.querySelector('[data-op-nav="${secao}"]').click()`);
        await check(`!document.querySelector('[data-op-panel="${secao}"]').hidden && document.querySelectorAll('[data-op-panel]:not([hidden])').length===1`, `Menu operador ${secao}`);
    }
    await evaluate("document.querySelector('[data-op-nav=alunos]').click()");
    await check("document.querySelector('.op-table').textContent.includes('Registro anterior à troca') && document.querySelector('.op-table').textContent.includes('Não verificado')",'Cadastros existentes visíveis sem inventar verificação ICFC');
    await evaluate("document.querySelector('[data-op-cadastro]').click()");
    await check("document.querySelector('[data-op-dialog]').open && document.querySelector('[data-op-dialog] input').matches(':disabled')",'Cadastro sem integração não simula criação');
    await evaluate("document.querySelector('[data-op-fechar]').click();document.querySelector('[data-op-nav=agenda]').click()");
    for(const modo of ['dia','semana','mes']) {
        await evaluate(`document.querySelector('[data-agenda-modo=${modo}]').click()`);
        await check("document.querySelector('.op-agenda-content').children.length>0 && testCalls.length===0",`Agenda ${modo} mantém componentes existentes sem API`);
    }
    await evaluate("window.servico=await (await import('/dev/aluno/authLocal.js')).criarServicoLocal();window.copia=await servico.backup()");
    await check("copia.registros.length===2 && copia.registros.some(r=>r.id==='preservar-na-troca') && copia.creditos.length===1 && !Object.hasOwn(copia,'contas')",'Backup inclui créditos e preserva os registros anteriores sem exportar conta');
    await send('Page.reload');await waitFor(()=>evaluate("document.body?.dataset.sipaLocal==='adm1' && document.readyState==='complete'"),'Operador após recarregar');
    await check("testCalls.length===0 && localStorage['sipa.operador.demo.v2']==='legado-preservado'",'Sessão local sobrevive ao reload sem importar os seeds');
    for(const [width,height] of [[1366,768],[390,844]]) {
        await send('Emulation.setDeviceMetricsOverride',{width,height,deviceScaleFactor:1,mobile:width<500});
        await check("document.documentElement.scrollWidth<=innerWidth",`Operador sem transbordamento ${width}`);
        await screenshot(`operador-local-${width}.png`);
    }
    await evaluate("document.querySelector('.sipa-local-navigation a').click()");
    await waitFor(()=>evaluate("location.pathname==='/login.html' && document.querySelector('#ambiente-teste')"),'Trocar ambiente');
    await check("document.querySelectorAll('#ambiente-teste option').length===6 && !document.querySelector('.local-workbench')",'Trocar retorna ao login sem interface Master');
    await evaluate("document.querySelector('#sair-ambiente').click()");
    await waitFor(()=>evaluate("document.querySelector('#sair-ambiente')?.hidden && document.readyState==='complete'"),'Logout local');
    await evaluate("window.servico=await (await import('/dev/aluno/authLocal.js')).criarServicoLocal();window.rejeita=async fn=>{try{await fn();return false;}catch{return true;}};");
    await check("!await servico.sessao() && await rejeita(()=>servico.selecionarInterface('adm1')) && sessionStorage['sipa.token']==='token-real-preservado-no-teste'",'Logout revoga acesso ao contexto, preservando token real');
    await check("await rejeita(()=>servico.prepararRecursosTeste()) && await rejeita(()=>servico.removerRecursosTeste())",'Preparação e limpeza de recursos exigem sessão local autenticada');
    await send('Page.navigate',{url:origin+'/aluno/html/dashboard.html'});
    await waitFor(()=>evaluate("location.pathname==='/login.html' && document.querySelector('#ambiente-teste')"),'Página sem sessão bloqueada');
    await preencher('#login-cpf','93541134780');await preencher('#login-password','135790');await submeter('#login-form');
    await waitFor(()=>evaluate("location.pathname==='/aluno/html/dashboard.html' && document.body?.dataset.sipaLocal==='aluno'"),'Novo login local');
    await check("document.querySelector('#credito-A').textContent==='20' && document.querySelector('#credito-B').textContent==='20' && document.querySelector('#student-name').textContent==='Matheus'",'Novo login mantém 40 créditos, sem duplicação');
    await navigate('/login.html?ambiente=integrado', "document.querySelector('#contato-recepcao').href.includes('text=')");
    await check("!document.querySelector('#ambiente-teste') && !document.querySelector('.local-workbench')",'Modo integrado não monta controles locais');
    for(const [perfil,destino] of [['Aluno','dashboard.html'],['Autoescola','autoescola.html']]) {
        await evaluate(`sessionStorage.setItem('test.response',JSON.stringify({status:200,body:{token:'teste',perfil:{descricao:${JSON.stringify(perfil)}}}}))`);
        await preencher('#login-cpf','52998224725');await preencher('#login-password','senha-de-teste');
        const urls=[];const listener=event=>{const m=JSON.parse(event.data);if(m.method==='Page.frameNavigated')urls.push(m.params.frame.url);};ws.addEventListener('message',listener);
        await submeter('#login-form');await waitFor(()=>urls.some(url=>url.includes('/'+destino)),`Contrato integrado ${perfil}`);ws.removeEventListener('message',listener);
        checks.push(`Redirecionamento integrado ${perfil} preservado`);
        await navigate('/login.html', "document.querySelector('#contato-recepcao').href.includes('text=')");
    }
    assert.deepEqual(consoleErrors,[],'Sem novos erros no console');checks.push('Sem novos erros de JavaScript');
    console.log(JSON.stringify({passed:checks.length,checks,medidasLayout,artifacts},null,2));
    }
} finally {
    if (ws?.readyState === WebSocket.OPEN) {
        try { await send("Browser.close"); } catch { /* processo pode já ter encerrado */ }
    }
    ws?.close();
    browser.kill();
    for (const item of pending.values()) { clearTimeout(item.timeout); item.reject(new Error("Teste encerrado")); }
    server.closeAllConnections();
    await new Promise(resolve => server.close(resolve));
}
