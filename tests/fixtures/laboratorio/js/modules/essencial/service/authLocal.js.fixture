        return navigator.locks.request("sipa.dev.local.registros", async () => substituir(await fn(await registros())));
    }
    async function dadosAlunoLocal() {
        const atual = await sessao(); if (!atual || atual.interface !== "aluno") throw new Error("Entre no ambiente local de Aluno.");
        const lista = await registros(), vinculados = lista.filter(r => r.tipo === "aluno" && r.documento === atual.identificador);
        if (vinculados.length > 1) throw new Error("Há cadastros duplicados para esta conta local. Confira o vínculo; nenhum dado foi alterado.");
        const aluno = vinculados[0];
        const credito = aluno ? await ler("creditos", aluno.id) : null;
        if (credito && credito.alunoId !== aluno.id) throw new Error("Os créditos locais não correspondem ao cadastro vinculado. Nenhum saldo foi alterado.");
        const aulas = aluno ? lista.filter(r => r.tipo === "aula" && r.aluno === aluno.id) : [];
        return { aluno, credito, aulas, registros: lista, resumo: resumirCreditos(credito, aulas), podeConfigurar: atual.identificador === DOCUMENTO_CREDITOS_TESTE };
    }
    function referenciasCancelamento(valor,id){
        if(typeof valor==='string')return valor===id;
        if(Array.isArray(valor))return valor.some(v=>referenciasCancelamento(v,id));
        return valor&&typeof valor==='object'&&Object.values(valor).some(v=>referenciasCancelamento(v,id));
    }
    async function planoCancelamentosTeste(){
        const dados=await dadosAlunoLocal(),saldos=await creditos();
        const candidatos=dados.aulas.filter(a=>a.status===2).map(a=>{
            const referencias=[...dados.registros.filter(r=>r.id!==a.id),...saldos].some(r=>referenciasCancelamento(r,a.id));
            // Reconhecer o formato local não certifica origem de teste: a confirmação
            // humana continua obrigatória. Metadados desconhecidos nunca são ignorados.
            const permitidos=['id','tipo','nome','aluno','categoria','unidade','instrutor','veiculo','inicio','fim','status','operacaoId','totalNoLote','ordemNoLote','criadoEm','historico','motivoCancelamento','cancelamento'];
            const desconhecidos=Object.keys(a).filter(k=>!permitidos.includes(k));
            const camposCancelamento=['versaoPolitica','minutosMinimos','milissegundosUteis','minutosUteis','dentroPrazo','semConsumoOriginal','em','motivoId','credito','frequencia','justificativa'];
            const cancelamentoSeguro=c=>{
                if(!c||typeof c!=='object'||Array.isArray(c)||Object.keys(c).some(k=>!camposCancelamento.includes(k)))return false;
                if(c.versaoPolitica!=='local-calendario-util-v2'||!Number.isFinite(Date.parse(c.em))||c.minutosMinimos!==2880||!Number.isFinite(c.minutosUteis)||c.minutosUteis<0||c.minutosUteis>2880||c.milissegundosUteis!==c.minutosUteis*60000||typeof c.dentroPrazo!=='boolean'||typeof c.semConsumoOriginal!=='boolean'||!identificarMotivo(c.motivoId))return false;
                if(c.frequencia==='cancelada'&&c.justificativa===null)return (c.dentroPrazo&&c.credito==='devolvido')||(c.semConsumoOriginal&&c.credito==='nao_consumido');
                if(c.dentroPrazo||c.semConsumoOriginal||c.credito!=='retido')return false;
                if(c.frequencia==='falta')return c.justificativa===null;
                const j=c.justificativa;
                return c.frequencia==='justificativa_pendente'&&c.motivoId==='saude'&&j?.estado==='aguardando_apresentacao'&&j.resultado===null&&Object.keys(j).every(k=>['estado','prazoApresentacao','resultado'].includes(k))&&Date.parse(j.prazoApresentacao)===Date.parse(c.em)+72*3600000;
            };
            const metadadosSeguros=a.cancelamento==null||cancelamentoSeguro(a.cancelamento);
            const historicoSeguro=Array.isArray(a.historico)&&a.historico.length>0&&a.historico.some(e=>e.status===2)&&a.historico.every(e=>[1,2,3,4].includes(e.status)&&Number.isFinite(Date.parse(e.em))&&Object.keys(e).every(k=>['status','em','motivo','cancelamento'].includes(k))&&(!e.cancelamento||(e.status===2&&cancelamentoSeguro(e.cancelamento)&&JSON.stringify(e.cancelamento)===JSON.stringify(a.cancelamento))));
            const origemLocal=a.cancelamento?.credito!=='retido'||(typeof a.operacaoId==='string'&&a.id==='reserva-'+a.operacaoId+(a.ordemNoLote?'-'+a.ordemNoLote:'')&&Number.isFinite(Date.parse(a.criadoEm))&&a.historico?.some(e=>e.status===1&&e.em===a.criadoEm));
            const seguro=origemLocal&&!referencias&&!desconhecidos.length&&metadadosSeguros&&historicoSeguro&&['A','B'].includes(a.categoria);
            return {registro:a,elegivel:seguro,motivo:!origemLocal?'Origem local não verificável. Baixe o backup e revise a identificação da reserva antes de solicitar a limpeza.':referencias?'Possui referência em outro registro ou crédito.':desconhecidos.length?'Metadados não reconhecidos: '+desconhecidos.join(', ')+'. Preservar para conferência.':!metadadosSeguros?'Metadados ou justificativa não verificáveis; preservar para revisão.':!seguro?'Histórico incompleto, incompatível ou com realização/falta; preservar.':'Sem referências externas ou impacto no saldo. Selecione somente se reconhecer como teste descartável.'};
        });
        return {alunoId:dados.aluno?.id||null,conta:(await sessao()).identificador,candidatos};
    }
    async function reservarLoteLocal(pedidoLote) {
        if (!navigator.locks) throw new Error("Este navegador não oferece o controle de concorrência necessário.");
        return navigator.locks.request("sipa.dev.local.registros", async () => {
            const dados = await dadosAlunoLocal();
            if (!dados.aluno?.unidade || dados.aluno.unidade === "Não informada") throw new Error("Vincule seu cadastro local de aluno à unidade antes de reservar.");
            const { categoria, operacaoId } = pedidoLote, unidade = normalizarUnidadeLocal(pedidoLote.unidade);
            if (!["A","B"].includes(categoria) || (pedidoLote.unidade != null && !UNIDADES_LOCAIS.includes(unidade))) throw new Error("Selecione categoria e unidade válidas.");
            if (!/^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$/i.test(operacaoId || "")) throw new Error("Identificador da operação inválido.");
            if (!Array.isArray(pedidoLote.aulas) || !pedidoLote.aulas.length) throw new Error("Selecione pelo menos uma aula para confirmar.");
            const selecoes = pedidoLote.aulas.map(a => ({data:a.data,hora:a.hora,unidade:normalizarUnidadeLocal(a.unidade || unidade),instrutorId:a.instrutorId,veiculoId:a.veiculoId})).sort((a,b)=>String(a.data).localeCompare(String(b.data))||String(a.hora).localeCompare(String(b.hora)));
            if (selecoes.some(a=>!UNIDADES_LOCAIS.includes(a.unidade))) throw new Error("Unidade da aula inválida.");
            if (new Set(selecoes.map(a=>a.data+'T'+a.hora)).size !== selecoes.length) throw new Error("Há horários repetidos na seleção. Nenhuma aula foi salva.");
            const ids = selecoes.map((_,i)=>'reserva-'+operacaoId+(i?'-'+i:''));
            const anteriores = dados.registros.filter(r=>r.operacaoId===operacaoId || ids.includes(r.id));
            if (anteriores.length) {
                if (anteriores.length!==selecoes.length || selecoes.some((a,i)=>!anteriores.some(r=>r.id===ids[i]&&r.tipo==='aula'&&r.aluno===dados.aluno.id&&r.categoria===categoria&&normalizarUnidadeLocal(r.unidade)===a.unidade&&r.inicio===a.data+'T'+a.hora+':00-03:00'&&r.instrutor===a.instrutorId&&r.veiculo===a.veiculoId))) throw new Error("Operação já utilizada para outra reserva ou lote. Nenhuma aula adicional foi salva.");
                return ids.map(id=>anteriores.find(r=>r.id===id));
            }
            if (!(dados.resumo.categorias[categoria]?.disponiveis >= selecoes.length)) throw new Error("Não há créditos disponíveis suficientes para todas as aulas. Nenhuma aula foi salva.");
            const novos = [], snapshot = {...dados,registros:[...dados.registros],aulas:[...dados.aulas]};
            for (const [i,a] of selecoes.entries()) {
                const unidade = a.unidade;
                const horario = (await calcularHorariosLocais(snapshot,{...a,categoria,unidade})).find(h=>h.hora===a.hora&&h.pares.some(p=>p.instrutorId===a.instrutorId&&p.veiculoId===a.veiculoId));
                if (!horario) throw new Error('Seleção '+(i+1)+' — '+a.data+' às '+a.hora+': horário ou recursos indisponíveis. Corrija esta aula; nenhuma seleção foi salva.');
                const em = new Date().toISOString();
                // Somente novas reservas locais: a API futura deverá confirmar na transação após validar disponibilidade.
                const r={id:ids[i],tipo:'aula',nome:'Aula prática local',aluno:dados.aluno.id,categoria,unidade,instrutor:a.instrutorId,veiculo:a.veiculoId,inicio:a.data+'T'+a.hora+':00-03:00',fim:a.data+'T'+horario.fim+':00-03:00',status:1,operacaoId,totalNoLote:selecoes.length,ordemNoLote:i,criadoEm:em,historico:[{status:1,em}]};
                novos.push(r);snapshot.registros.push(r);snapshot.aulas.push(r);
            }
            proteger();
            const tx=db.transaction('registros','readwrite'),done=fim(tx);
            try { novos.forEach(r=>tx.objectStore('registros').add(r)); }
            catch (erro) { try { tx.abort(); } catch {} await done.catch(()=>{}); throw erro; }
            await done;
            return novos;
        });
    }
    return {
        async contaConfigurada() { return Boolean(await ler("contas", "master")); },
        async identificadorLocal(valor) { return (await ler("contas", "master"))?.identificador === valor; },
        async configurar(identificador, senha) {
            proteger();
            if (!/^\d{11}$/.test(identificador) || senha.length !== 6) throw new Error("Use um identificador de 11 dígitos e senha provisória com exatamente 6 caracteres.");
            await gravar("contas", { id: "master", identificador, ...await segredo(senha), ativa: true, provisoria: true }, true);
        },
        async entrar(identificador, senha) {
            proteger(); const conta = await ler("contas", "master");
            if (!conta || conta.identificador !== identificador || await derivar(senha, conta.sal) !== conta.hash) throw new Error("Credenciais locais inválidas.");
            if (!conta.ativa) throw new Error("Conta local desativada.");
            if (conta.provisoria) return { trocaObrigatoria: true };
            const nonce = hex(crypto.getRandomValues(new Uint8Array(32)));
            const id = hex(await crypto.subtle.digest("SHA-256", bytes(nonce)));
            await gravar("sessoes", { id, expira: Date.now() + 2 * 60 * 60 * 1000 });
            sessionStorage.setItem(CHAVE, nonce);
            return { trocaObrigatoria: false };
        },
        async trocarSenha(identificador, anterior, nova) {
            proteger(); const conta = await ler("contas", "master");
            if (!conta || conta.identificador !== identificador || !conta.provisoria || await derivar(anterior, conta.sal) !== conta.hash) throw new Error("Senha provisória inválida.");
            // Política simplificada somente do Master demonstrativo, protegida
            // pelo modo local acima. Login de contas existentes não é alterado.
            if (nova.length !== 6) throw new Error("A nova senha deve ter exatamente 6 caracteres.");
            await gravar("contas", { ...conta, ...await segredo(nova), provisoria: false });
        },
        async alterarSenhaLocal({atual,nova,confirmacao}={}){
            proteger();
            const falha=(codigo,mensagem)=>Object.assign(new Error(mensagem),{codigo:'senha_local_'+codigo});
            if(typeof atual!=='string'||!atual)throw falha('atual','Informe sua senha atual.');
            if(typeof nova!=='string'||!nova)throw falha('nova','Informe uma nova senha.');
            if(nova.length!==6)throw falha('politica','A nova senha deve ter exatamente 6 caracteres.');
            if(confirmacao!==nova)throw falha('confirmacao','A confirmação não corresponde à nova senha.');
            if(nova===atual)throw falha('igual','A nova senha deve ser diferente da senha atual.');
            if(!navigator.locks)throw falha('suporte','Este navegador não oferece os recursos necessários para alterar a senha local.');
            return navigator.locks.request('sipa.dev.local.credencial',async()=>{
                const autenticada=await sessao(),conta=await ler('contas','master');
                if(!autenticada||autenticada.interface!=='aluno'||!conta||conta.identificador!==autenticada.identificador||conta.provisoria||!conta.ativa)throw falha('sessao','Entre novamente na sua conta local de Aluno.');
                if(await derivar(atual,conta.sal)!==conta.hash)throw falha('incorreta','A senha atual está incorreta.');
                const credencial=await segredo(nova);
                const tx=db.transaction('contas','readwrite'),done=fim(tx);
                try{tx.objectStore('contas').put({...conta,...credencial});}catch(e){tx.abort();await done.catch(()=>{});throw e;}await done;
            });
        },
        sessao,
        async selecionarInterface(interfaceLocal) {
            if (!["aluno", "adm1"].includes(interfaceLocal)) throw new Error("Interface local ainda não disponível.");
            await exigirSessao();
            const nonce = sessionStorage.getItem(CHAVE);
            const id = hex(await crypto.subtle.digest("SHA-256", bytes(nonce)));
            const registro = await ler("sessoes", id);
            if (!registro || registro.expira <= Date.now()) throw new Error("Entre novamente no ambiente local.");
            await gravar("sessoes", { ...registro, interface: interfaceLocal });
        },
        async sair() {
            proteger(); const nonce = sessionStorage.getItem(CHAVE); sessionStorage.removeItem(CHAVE);
            if (nonce) { const id = hex(await crypto.subtle.digest("SHA-256", bytes(nonce))); const tx = db.transaction("sessoes", "readwrite"), done = fim(tx); tx.objectStore("sessoes").delete(id); await done; }
        },
        registros,
        dadosAlunoLocal,
        async consultarPoliticaCancelamento(id) {
            const dados = await dadosAlunoLocal(), aula = dados.aulas.find(a=>a.id===id);
            if (!aula) throw new Error('Reserva não encontrada para este aluno.');
            return calcularPrazoCancelamento(aula,dados.registros);
        },
        async buscarAgendamentoAutomatico(preferencias) {
            return gerarPropostaAutomatica(await dadosAlunoLocal(),preferencias,calcularHorariosLocais);
        },
        async salvarPreferenciasAutomaticas(valor) {
            const atual = await dadosAlunoLocal();
            if (!atual.aluno) throw new Error('Cadastre o aluno antes de salvar preferências.');
            return alterar(async lista=>{
                const dados = await dadosAlunoLocal();
                if (dados.aluno?.id !== atual.aluno.id) throw new Error('A sessão mudou. Entre novamente.');
                const p = normalizarPreferenciasAutomaticas(valor,lista);
                if (!(dados.resumo.categorias[p.categoria].disponiveis >= p.quantidade)) throw new Error('Quantidade superior ao saldo disponível da categoria.');
                const em = new Date().toISOString(), preferencias = { ...p, alunoId:dados.aluno.id, atualizadoEm:em };
                return lista.map(r=>r.id===dados.aluno.id?{...r,preferenciasAutomaticas:preferencias,historicoPreferencias:[...(r.historicoPreferencias||[]),{tipo:'automatico',em,valor:preferencias}]}:r);
            });
        },
        async salvarAvisosAntecipacao(notificacoes, disponibilidade) {
            if (typeof notificacoes !== 'boolean') throw new Error('Informe uma preferência válida.');
            const atual = await dadosAlunoLocal();
            if (!atual.aluno) throw new Error('Cadastre o aluno antes de salvar a preferência.');
            return alterar(async lista=>{
                const dados = await dadosAlunoLocal();
                if (dados.aluno?.id !== atual.aluno.id) throw new Error('A sessão mudou. Entre novamente.');
                const em = new Date().toISOString(), anterior = dados.aluno.antecipacao || {};
                const preferencias=normalizarDisponibilidadeAntecipacao(disponibilidade??anterior.disponibilidade??{},notificacoes);
                const antecipacao = { ...anterior, versaoDisponibilidade:1, disponibilidade:preferencias, diasDisponiveis:Object.keys(preferencias).filter(d=>preferencias[d].length).map(Number), alunoId:dados.aluno.id, unidadeVinculo:dados.aluno.unidade, ativo:notificacoes, notificacoes, atualizadoEm:em, ativadoEm:notificacoes?(anterior.ativo?anterior.ativadoEm||em:em):anterior.ativadoEm||null };
                return lista.map(r=>r.id===dados.aluno.id?{...r,antecipacao,historicoPreferencias:[...(r.historicoPreferencias||[]),{tipo:'avisos_antecipacao',em,valor:antecipacao}]}:r);
            });
        },
        async salvarAntecipacao(valor) {
            const preferencia = normalizarAntecipacao(valor), atual = await dadosAlunoLocal();
            if (!atual.aluno) throw new Error('Cadastre o aluno antes de salvar preferências.');
            return alterar(async lista=>{
                const dados = await dadosAlunoLocal();
                if (dados.aluno?.id !== atual.aluno.id) throw new Error('A sessão mudou. Entre novamente.');
                const em = new Date().toISOString(), anterior = dados.aluno.antecipacao;
                const antecipacao = { ...preferencia, alunoId:dados.aluno.id, unidadeVinculo:dados.aluno.unidade, ativadoEm:preferencia.ativo?anterior?.ativo?anterior.ativadoEm:em:anterior?.ativadoEm||null, atualizadoEm:em };
                return lista.map(r=>r.id===dados.aluno.id?{...r,antecipacao,historicoPreferencias:[...(r.historicoPreferencias||[]),{tipo:'antecipacao',em,valor:antecipacao}]}:r);
            });
        },
        async disponibilidadeLocal(consulta) {
            const dados = await dadosAlunoLocal();
            return calcularHorariosLocais(dados, consulta);
        },
        async consultarRecursosLocal(consulta) { return consultarRecursosLocais(await dadosAlunoLocal(), consulta); },
        async prepararRecursosTeste() {
            if (!navigator.locks) throw new Error("Este navegador não oferece o controle de concorrência necessário.");
            return navigator.locks.request("sipa.dev.local.registros", async () => {
                await dadosAlunoLocal();
                const lista = await registros(), plano = criarRecursosFicticiosLocais(), faltantes = [];
                for (const r of plano) {
                    const existente = lista.find(e => e.id === r.id);
                    if (existente) {
                        if (!recursoFicticioGerado(existente)) throw new Error(`O identificador ${r.id} já está em uso por outro cadastro. Nenhum recurso foi criado.`);
                        continue;
                    }
                    if (lista.some(e => e.tipo !== "aula" && String(e.documento || "").replace(/[^a-z0-9]/gi, "").toUpperCase() === r.documento)) throw new Error(`O identificador sintético ${r.documento} já está em uso. Nenhum cadastro foi sobrescrito.`);
                    faltantes.push(r);
                }
                // Apenas os candidatos são validados e adicionados: cadastros legados
                // não são normalizados, regravados ou substituídos pela preparação.
                const novos = validarRegistros(faltantes);
                if (novos.length) {
                    proteger();
                    const tx = db.transaction("registros", "readwrite"), done = fim(tx);
                    for (const r of novos) tx.objectStore("registros").add(r);
                    await done;
                }
                return { instrutoresCriados: novos.filter(r => r.tipo === "instrutor").length, veiculosCriados: novos.filter(r => r.tipo === "veiculo").length, existentes: plano.length - novos.length };
            });
        },
        async consultarLimpezaRecursosTeste() {
            await dadosAlunoLocal();
            const plano = planejarLimpezaRecursos(await registros());
            return { removiveis: plano.removiveis.length, preservados: plano.dependencias.length, dependencias: plano.dependencias };
        },
        async removerRecursosTeste() {
            if (!navigator.locks) throw new Error("Este navegador não oferece o controle de concorrência necessário.");
            return navigator.locks.request("sipa.dev.local.registros", async () => {
                await dadosAlunoLocal();
                const plano = planejarLimpezaRecursos(await registros());
                if (plano.removiveis.length) {
                    proteger();
                    const tx = db.transaction("registros", "readwrite"), done = fim(tx);
                    for (const r of plano.removiveis) tx.objectStore("registros").delete(r.id);
                    await done;
                }
                return { removidos: plano.removiveis.length, preservados: plano.dependencias.length, dependencias: plano.dependencias };
            });
        },
        async salvarRecursoLocal(item) {
            const atual = await sessao();
            if (atual?.interface !== "aluno") throw new Error("Entre no ambiente local de Aluno para configurar recursos de testes.");
            if (!["instrutor", "veiculo"].includes(item.tipo) || !UNIDADES_LOCAIS.includes(normalizarUnidadeLocal(item.unidade))) throw new Error("Informe tipo de recurso e unidade válidos.");
            validarDisponibilidadeSemanal(item.disponibilidadeSemanal);
            if (item.tipo === "instrutor" ? !item.categorias?.length : !["A", "B"].includes(item.categoria)) throw new Error("Informe a categoria de habilitação ou do veículo.");
            return alterar(lista => {
                const anterior = item.id && lista.find(r => r.id === item.id);
                if (item.id && (!anterior || anterior.tipo !== item.tipo)) throw new Error("Recurso a editar não encontrado ou tipo incompatível.");
                const id = anterior?.id || crypto.randomUUID();
                return [...lista.filter(r => r.id !== id), { ...anterior, ...item, id, unidade: normalizarUnidadeLocal(item.unidade) }];
            });
        },
        planoCancelamentosTeste,
        async limparCancelamentosTeste({ids,registrosConfirmados,confirmarTestes}={}){
            proteger();if(!navigator.locks)throw new Error('Controle de concorrência indisponível.');
            if(confirmarTestes!==true||!Array.isArray(ids)||!ids.length||new Set(ids).size!==ids.length)throw new Error('Selecione e confirme especificamente os cancelamentos descartáveis de teste.');
            return navigator.locks.request('sipa.dev.local.registros',async()=>{
                const plano=await planoCancelamentosTeste(),dados=await dadosAlunoLocal();
                const selecionados=ids.map(id=>plano.candidatos.find(c=>c.registro.id===id));
                if(selecionados.some(c=>!c?.elegivel))throw new Error('Seleção inválida, de outra conta ou com dependências. Nada foi removido.');
                const afetados=selecionados.map(c=>c.registro);
                if(JSON.stringify(afetados)!==JSON.stringify(registrosConfirmados))throw new Error('Os registros mudaram. Reabra a conferência antes de limpar.');
                const restantes=dados.aulas.filter(a=>!ids.includes(a.id));
                const retidos=afetados.filter(a=>a.cancelamento?.credito==='retido');
                if(retidos.length&&!dados.credito)throw new Error('Não há registro de crédito para preservar o consumo. Nada foi removido.');
                const chave='sipa.dev.backup.cancelamentos.'+crypto.randomUUID();
                const creditoPreservado=retidos.length?{...dados.credito,consumosPreservadosLimpeza:[...(dados.credito.consumosPreservadosLimpeza||[]),...retidos.map(a=>({id:crypto.randomUUID(),categoria:a.categoria,quantidade:1,backup:chave,cancelamento:structuredClone(a.cancelamento)}))]}:dados.credito;
                if(JSON.stringify(resumirCreditos(creditoPreservado,restantes))!==JSON.stringify(dados.resumo))throw new Error('A remoção afetaria os saldos. Nada foi removido.');
                const backup={formato:'sipa-cancelamentos-teste-v1',criadoEm:new Date().toISOString(),alunoId:plano.alunoId,registros:afetados,credito:dados.credito,referencias:dados.registros.filter(r=>afetados.some(a=>[a.aluno,a.instrutor,a.veiculo].includes(r.id)))};
                const conteudo=JSON.stringify(backup);
                // Backup durável separado do IndexedDB; se faltar espaço, a limpeza é recusada.
                localStorage.setItem(chave,conteudo);if(localStorage.getItem(chave)!==conteudo)throw new Error('Não foi possível preservar o backup. Nada foi removido.');
                const tx=db.transaction(['registros','creditos'],'readwrite'),done=fim(tx);try{const store=tx.objectStore('registros');ids.forEach(id=>store.delete(id));if(retidos.length)tx.objectStore('creditos').put(creditoPreservado);}catch(e){tx.abort();await done.catch(()=>{});throw e;}await done;
                return {removidos:afetados.length,chaveBackup:chave,backup};
            });
        },
        reservarAulasLocais: reservarLoteLocal,
        async reservarAulaLocal(consulta) {
            return (await reservarLoteLocal({categoria:consulta.categoria,unidade:consulta.unidade,operacaoId:consulta.operacaoId,aulas:[consulta]}))[0];
        },
        async cancelarReservaLocal(id, motivo, { aceitarConsequencias = false } = {}) {
            if (!navigator.locks) throw new Error("Este navegador não oferece o controle de concorrência necessário.");
            return navigator.locks.request("sipa.dev.local.registros", async () => {
                const dados = await dadosAlunoLocal(), aula = dados.aulas.find(a => a.id === id);
                if (!aula) throw new Error("Reserva não encontrada para este aluno.");
                if (aula.status === 2) return aula;
                // Regra exclusiva do laboratório: confirmadas futuras podem ser canceladas.
                // Produção deverá aplicar a política de prazo validada pela API.
                if (![1, 3, 4].includes(aula.status) || (aula.status === 1 && !(Date.parse(aula.inicio) > Date.now()))) throw new Error("Somente aulas confirmadas futuras ou reservas pendentes podem ser canceladas localmente.");
                const motivoEscolhido = typeof motivo === 'string' ? motivo.trim() : '';
                if (!identificarMotivo(motivoEscolhido)) throw new Error('Selecione o motivo do cancelamento para continuar.');
                const cancelamento = criarCancelamento(aula, dados.registros, motivoEscolhido, aceitarConsequencias);
                const registro = { ...aula, status: 2, cancelamento, motivoCancelamento: motivoEscolhido, historico: [...(aula.historico || []), { status: 2, em: cancelamento.em, motivo: motivoEscolhido, cancelamento: structuredClone(cancelamento) }] };
                await gravar("registros", registro); return registro;
            });
        },
        async configurarUnidadeTeste() {
            if (!navigator.locks) throw new Error("Atualize o navegador para configurar o vínculo com segurança.");
            return navigator.locks.request("sipa.dev.local.registros", async () => {
                const atual = await sessao();
                if (atual?.interface !== "aluno" || atual.identificador !== DOCUMENTO_CREDITOS_TESTE) throw new Error("Configuração exclusiva da conta local de testes autorizada.");
                const dados = await dadosAlunoLocal();
                if (!dados.aluno) throw new Error("Configure primeiro o cadastro da sua conta de testes no dashboard. Nenhum aluno foi criado.");
                if (dados.aluno.unidade === "Cobilândia") return { aplicado: false };
                await gravar("registros", { ...dados.aluno, unidade: "Cobilândia" });
                return { aplicado: true };
            });
        },
        async configurarCreditosTeste() {
            const atual = await sessao();
            if (atual?.interface !== "aluno" || atual.identificador !== DOCUMENTO_CREDITOS_TESTE) throw new Error("Configuração exclusiva da conta local de testes autorizada.");
            if (!navigator.locks) throw new Error("Atualize o navegador para configurar os créditos com segurança.");
            return navigator.locks.request("sipa.dev.local.registros", async () => {
                const lista = await registros(), candidatos = lista.filter(r => r.tipo === "aluno" && r.documento === DOCUMENTO_CREDITOS_TESTE);
                if (candidatos.length > 1) throw new Error("Há cadastros duplicados para esta conta. Nenhum dado foi alterado.");
                const existente = candidatos[0];
                if (!existente && lista.some(r => r.tipo === "instrutor" && r.documento === DOCUMENTO_CREDITOS_TESTE)) throw new Error("Há um cadastro de instrutor com este documento. Confira o vínculo antes de criar o aluno; nenhum dado foi alterado.");
                if (existente) {
                    const saldos = (await creditos()).filter(c => c.alunoId === existente.id);
                    if (saldos.length) {
                        if (saldos.length !== 1 || saldos[0].id !== existente.id || saldos[0].origem !== "configuracao-local-tela03" || saldos[0].categorias?.A !== 20 || saldos[0].categorias?.B !== 20) throw new Error("Há créditos existentes diferentes da configuração solicitada. Nenhum saldo foi sobrescrito.");
                        return { aplicado: false };
                    }
                }
                const aulas = existente ? lista.filter(r => r.tipo === "aula" && r.aluno === existente.id) : [];
                if (aulas.some(a => !["A", "B"].includes(a.categoria) || ![1, 2, 3, 4, 5, 6].includes(a.status))) throw new Error("Existem aulas sem categoria ou situação definida. Preserve o histórico e confira esses registros antes de configurar créditos.");
                if (Object.values(resumirCreditos({ categorias: { A: 20, B: 20 } }, aulas).categorias).some(c => c.consumidas > 20)) throw new Error("O histórico consome mais créditos que os solicitados. Nenhum dado foi alterado; confira os saldos antes de prosseguir.");
                if (existente && ["saldo", "saldos", "creditos", "aulasRestantes", "aulasContratadas"].some(c => existente[c] != null)) throw new Error("Este cadastro já possui informações de saldo. Nenhum valor foi sobrescrito; confira o saldo existente antes de prosseguir.");
                const aluno = { ...existente, id: existente?.id || crypto.randomUUID(), tipo: "aluno", documento: DOCUMENTO_CREDITOS_TESTE, nome: "Matheus", unidade: existente?.unidade || "Não informada" };
                const tx = db.transaction(["registros", "creditos"], "readwrite"), done = fim(tx);
                tx.objectStore("registros").put(aluno);
                tx.objectStore("creditos").add({ id: aluno.id, alunoId: aluno.id, categorias: { A: 20, B: 20 }, origem: "configuracao-local-tela03", criadoEm: new Date().toISOString() });
                await done; return { aplicado: true };
            });
        },
        salvar(item) { return alterar(lista => { const id = item.id || crypto.randomUUID(); return [...lista.filter(r => r.id !== id), { ...item, id }]; }); },
        excluir(id) { return alterar(lista => lista.filter(r => r.id !== id)); },
        async backup() { return { formato: "sipa-local-v1", registros: await registros(), creditos: await creditos() }; },
        async restaurar(backup) { if (backup?.formato !== "sipa-local-v1") throw new Error("Formato de backup desconhecido."); if (backup.creditos?.length) throw new Error("A restauração de créditos requer integração específica. Nenhum dado foi alterado."); return alterar(() => backup.registros); },
    };
}
