import { normalizarDisponibilidadeAntecipacao, MOTIVOS_CANCELAMENTO, identificarMotivo, criarCancelamento, normalizarPreferenciasAutomaticas, normalizarAntecipacao, gerarPropostaAutomatica, calcularPrazoCancelamento } from './agendamentoAluno.js';
import { UNIDADES_INSTITUCIONAIS, normalizarChaveUnidade, nomeUnidadeInstitucional } from '../../unidades/catalogoUnidades.js';
// Laboratório isolado: nunca emite JWT, importa serviços HTTP ou altera sipa.token.
// Para desativar completamente o laboratório, altere esta constante para false.
export const DESENVOLVIMENTO_LOCAL_HABILITADO = true;
export const MOTIVOS_CANCELAMENTO_LOCAL = Object.freeze(MOTIVOS_CANCELAMENTO.map(m=>m.nome));
export const CHAVE_AMBIENTE_LOCAL = "sipa.dev.ambiente";
export function hostLocalPermitido(endereco) {
    let url;
    try { url = new URL(endereco); } catch { return false; }
    return DESENVOLVIMENTO_LOCAL_HABILITADO && ["http:", "https:"].includes(url.protocol)
        && ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
}
// Preferência explícita de execução, independente da existência de conta ou sessão.
export function resolverAmbiente(endereco, preferencia = null) {
    const url = new URL(endereco), modos = url.searchParams.getAll("ambiente");
    if (modos.length > 1 || (modos.length === 1 && !["local", "integrado"].includes(modos[0]))) throw new Error("Seleção de ambiente inválida.");
    if (!hostLocalPermitido(endereco)) {
        if (modos[0] === "local") throw new Error("Ambiente local não autorizado neste endereço.");
        return "integrado";
    }
    return modos[0] || (preferencia === "local" ? "local" : "integrado");
}
export function modoLocalPermitido(endereco, preferencia = null) {
    try { return hostLocalPermitido(endereco) && resolverAmbiente(endereco, preferencia) === "local"; } catch { return false; }
}
export function ambienteAtual() {
    const endereco = window.location.href;
    // Fora do loopback, nem lê preferências de desenvolvimento.
    let preferencia = null;
    if (hostLocalPermitido(endereco)) {
        try { preferencia = localStorage.getItem(CHAVE_AMBIENTE_LOCAL); }
        catch { throw new Error("Não foi possível ler a configuração local. Libere o armazenamento deste site no navegador."); }
    }
    return resolverAmbiente(endereco, preferencia);
}
export function configurarAmbienteAtual() {
    const ambiente = ambienteAtual();
    if (hostLocalPermitido(window.location.href) && new URL(window.location.href).searchParams.has("ambiente")) {
        localStorage.setItem(CHAVE_AMBIENTE_LOCAL, ambiente);
    }
    return ambiente;
}
const CHAVE = "sipa.dev.local.session";
export const DOCUMENTO_CREDITOS_TESTE = "17825035798";
// Consulta derivada; não debita saldo nem modifica o histórico. Mesmas regras de
// Consome/Expirada do domínio: 3 e 4 só reservam antes do início; falta consome.
export function resumirCreditos(credito, aulas = [], agora = Date.now()) {
    const categorias = Object.fromEntries(["A", "B"].map(categoria => [categoria, { total: credito?.categorias?.[categoria] || 0, disponiveis: 0, reservadas: 0, realizadas: 0, consumidas: 0 }]));
    let incompletas = 0;
    // Consumos já existentes preservados ao retirar históricos descartáveis.
    for(const item of credito?.consumosPreservadosLimpeza || []) {
        if(categorias[item.categoria]&&item.quantidade===1) categorias[item.categoria].consumidas++;
        else incompletas++;
    }
    const vistos = new Set();
    for (const aula of aulas) {
        if (vistos.has(aula.id)) continue; vistos.add(aula.id);
        const c = categorias[aula.categoria], status = aula.status, inicio = Date.parse(aula.inicio);
        if (!c || ![1, 2, 3, 4, 5, 6].includes(status) || !Number.isFinite(inicio)) { incompletas++; continue; }
        if (status === 5) c.realizadas++;
        if ([1, 3, 4].includes(status) && inicio > agora) c.reservadas++;
        if ([1, 5, 6].includes(status) || (status === 2 && aula.cancelamento?.credito === "retido") || ([3, 4].includes(status) && inicio > agora)) c.consumidas++;
    }
    for (const c of Object.values(categorias)) c.disponiveis = incompletas ? null : Math.max(0, c.total - c.consumidas);
    const total = Object.values(categorias).reduce((s, c) => s + c.total, 0), realizadas = Object.values(categorias).reduce((s, c) => s + c.realizadas, 0);
    return { categorias, incompletas, total, realizadas, percentual: total && realizadas && !incompletas ? Math.min(100, Math.round(realizadas * 100 / total)) : null };
}
// Apresentação por categoria reutiliza o mesmo domínio de consumo de créditos.
export function progressoPorCategoria(credito,aulas=[],agora=Date.now()){
    const resumo=resumirCreditos(credito,aulas,agora);
    for(const c of Object.values(resumo.categorias))c.percentual=c.total>0&&!resumo.incompletas?Math.min(100,Math.round(c.realizadas*100/c.total)):null;
    return resumo;
}
// Consulta pura sobre um snapshot local. A gravação reexecuta esta consulta sob
// o mesmo lock usado pelos demais escritores, nunca confia no horário do DOM.
// Mesmas seis unidades divulgadas nas páginas públicas. Não representam recursos disponíveis.
export const UNIDADES_LOCAIS = Object.freeze(UNIDADES_INSTITUCIONAIS.map(u=>u.id));
export const normalizarUnidadeLocal=normalizarChaveUnidade;
export const nomeUnidadeLocal=nomeUnidadeInstitucional;
const SEED_RECURSOS = "sipa-recursos-agendamento-v1";
export function criarRecursosFicticiosLocais() {
    const registros = []; let sequencia = 0;
    for (const [u, unidade] of UNIDADES_LOCAIS.entries()) for (const categoria of ["A", "B"]) for (let n = 1; n <= 2; n++) {
        sequencia++;
        const base = `sipa-seed-recursos-v1-u${u + 1}-${categoria.toLowerCase()}-${n}`;
        const jornada = () => Array.from({ length: 6 }, (_, d) => ({ dia: d + 1, inicio: "07:00", fim: d === 5 ? "12:00" : "19:00" }));
        const comum = { unidade, ativo: true, disponivel: true, seedId: SEED_RECURSOS, dadosDeTeste: true };
        registros.push({ ...comum, id: `${base}-instrutor`, tipo: "instrutor", nome: `Instrutor Teste ${String(n).padStart(2, "0")} — ${unidade} · ${categoria} (fictício)`, documento: `TSTI${String(sequencia).padStart(4, "0")}`, categorias: [categoria], veiculoIds: [`${base}-veiculo`], disponibilidadeSemanal: jornada() });
        registros.push({ ...comum, id: `${base}-veiculo`, tipo: "veiculo", nome: `${categoria === "A" ? "Moto" : "Carro"} Teste ${String(n).padStart(2, "0")} — ${unidade} (fictício)`, documento: `TSTV${String(sequencia).padStart(4, "0")}`, categoria, disponibilidadeSemanal: jornada() });
    }
    return registros;
}
function recursoFicticioGerado(registro) {
    if (!registro || registro.seedId !== SEED_RECURSOS || registro.dadosDeTeste !== true) return false;
    return criarRecursosFicticiosLocais().some(r => r.id === registro.id && r.tipo === registro.tipo && r.documento === registro.documento);
}
function planejarLimpezaRecursos(lista) {
    const gerados = lista.filter(recursoFicticioGerado), ids = new Set(gerados.map(r => r.id)), protegidos = new Map();
    const proteger = (id, origem) => {
        if (!ids.has(id)) return;
        if (!protegidos.has(id)) protegidos.set(id, new Set());
        protegidos.get(id).add(origem);
    };
    for (const r of lista) if (r.tipo === "aula") { proteger(r.instrutor, `aula ${r.id}`); proteger(r.veiculo, `aula ${r.id}`); }
    // Mantém veículos apontados por cadastros manuais ou instrutores preservados.
    let anteriores;
    do {
        anteriores = protegidos.size;
        for (const r of lista) if (!ids.has(r.id) || protegidos.has(r.id)) {
            for (const id of Array.isArray(r.veiculoIds) ? r.veiculoIds : []) proteger(id, `cadastro ${r.id}`);
        }
    } while (anteriores !== protegidos.size);
    return {
        removiveis: gerados.filter(r => !protegidos.has(r.id)),
        dependencias: gerados.filter(r => protegidos.has(r.id)).map(r => ({ id: r.id, nome: r.nome, referencias: [...protegidos.get(r.id)] }))
    };
}
export function validarDisponibilidadeSemanal(jornada) {
    const hora = h => typeof h === "string" && /^([01]\d|2[0-3]):[0-5]\d$/.test(h);
    if (!Array.isArray(jornada) || !jornada.length || jornada.length > 7 || new Set(jornada.map(j => j?.dia)).size !== jornada.length || jornada.some(j => !j || !Number.isInteger(j.dia) || j.dia < 0 || j.dia > 6 || !hora(j.inicio) || !hora(j.fim) || j.inicio >= j.fim)) throw new Error("Informe dias e horários válidos de disponibilidade, sem dias repetidos.");
    return jornada;
}
export async function calcularHorariosLocais(dados, consulta, agora) {
    const [{ validarHorario, motivoFechamento }, { agoraBrasil, dataValida, diaSemana }] = await Promise.all([
        import("../../compartilhado/disponibilidade.js"), import("../../compartilhado/calendario.js")
    ]);
    agora ||= agoraBrasil();
    const { categoria, data, unidade } = consulta;
    if (!["A", "B"].includes(categoria) || !dataValida(data) || !unidade || data < agora.slice(0, 10)) return [];
    if (motivoFechamento(data) || !dados.aluno?.unidade || dados.aluno.unidade === "Não informada") return [];
    const recursos = dados.registros.filter(r => ["instrutor", "veiculo"].includes(r.tipo) && normalizarUnidadeLocal(r.unidade) === normalizarUnidadeLocal(unidade));
    const emMinutos = h => Number(h.slice(0, 2)) * 60 + Number(h.slice(3, 5));
    const sobrepoe = (a, b, c, d) => emMinutos(a) < emMinutos(d) && emMinutos(c) < emMinutos(b);
    const bloqueado = (r, hora, fim) => (r.bloqueios || []).some(b => b.data === data && (!b.inicio || sobrepoe(hora, fim, b.inicio, b.fim)));
    if (recursos.some(r => (r.feriadosUnidade || []).includes(data) || (r.bloqueiosUnidade || []).some(b => b.data === data && !b.inicio))) return [];
    const livres = (r, hora, fim) => r.ativo === true && r.disponivel !== false && !bloqueado(r, hora, fim) &&
        (r.disponibilidadeSemanal == null || (Array.isArray(r.disponibilidadeSemanal) && r.disponibilidadeSemanal.some(j => j.dia === diaSemana(data) && j.inicio <= hora && fim <= j.fim))) &&
        !recursos.some(u => (u.bloqueiosUnidade || []).some(b => b.data === data && b.inicio && sobrepoe(hora, fim, b.inicio, b.fim))) &&
        !dados.registros.some(a => a.tipo === "aula" && [1, 3, 5, 6].includes(a.status ?? 1) && (a.instrutor === r.id || a.veiculo === r.id) && Date.parse(a.inicio) < Date.parse(`${data}T${fim}:00-03:00`) && Date.parse(`${data}T${hora}:00-03:00`) < Date.parse(a.fim));
    const horarios = [];
    for (let h = 7; h <= 18; h++) {
        const hora = `${String(h).padStart(2, "0")}:00`, fim = `${String(h + 1).padStart(2, "0")}:00`;
        if (validarHorario(data, hora) || `${data}T${hora}:00` <= agora) continue;
        if (dados.aulas.some(a => [1, 3, 5, 6].includes(a.status ?? 1) && Date.parse(a.inicio) < Date.parse(`${data}T${fim}:00-03:00`) && Date.parse(`${data}T${hora}:00-03:00`) < Date.parse(a.fim))) continue;
        const instrutores = recursos.filter(r => r.tipo === "instrutor" && r.categorias?.includes(categoria) && livres(r, hora, fim));
        const veiculos = recursos.filter(r => r.tipo === "veiculo" && r.categoria === categoria && livres(r, hora, fim));
        const pares = instrutores.flatMap(i => veiculos.filter(v => !i.veiculoIds?.length || i.veiculoIds.includes(v.id)).map(v => ({ instrutorId: i.id, veiculoId: v.id })));
        if (pares.length) horarios.push({ hora, fim, pares });
    }
    return horarios;
}
export async function consultarRecursosLocais(dados, consulta, agora) {
    const recursos = dados.registros.filter(r => normalizarUnidadeLocal(r.unidade) === normalizarUnidadeLocal(consulta.unidade));
    const instrutores = recursos.filter(r => r.tipo === "instrutor" && r.categorias?.includes(consulta.categoria));
    const veiculos = recursos.filter(r => r.tipo === "veiculo" && r.categoria === consulta.categoria);
    const contagem = { instrutores: instrutores.length, veiculos: veiculos.length };
    const resposta = mensagem => ({ horarios: [], mensagem, contagem });
    if (!consulta.unidade) return resposta("Selecione a unidade da aula.");
    if (!dados.aluno?.unidade || dados.aluno.unidade === "Não informada") return resposta("Configure a unidade de vínculo da sua conta no dashboard antes de reservar.");
    if (!instrutores.length) return resposta("Sem instrutores cadastrados para esta unidade e categoria. Cadastre ou complete a habilitação do instrutor na configuração local abaixo.");
    if (!veiculos.length) return resposta("Sem veículos cadastrados para esta unidade e categoria. Cadastre carro para B ou moto para A na configuração local abaixo.");
    if (!consulta.data) return resposta("Recursos encontrados. Selecione uma data para consultar jornadas, bloqueios e conflitos.");
    const horarios = await calcularHorariosLocais(dados, consulta, agora);
    if (horarios.length) return { horarios, mensagem: "Horários válidos calculados pelos recursos locais.", contagem };
    const { motivoFechamento } = await import("../../compartilhado/disponibilidade.js");
    const fechamento = motivoFechamento(consulta.data);
    if (fechamento) return resposta(fechamento);
    const semConflitos = await calcularHorariosLocais({ ...dados, aulas: [], registros: dados.registros.filter(r => r.tipo !== "aula") }, consulta, agora);
    return resposta(semConflitos.length ? "Horários ocupados por outros agendamentos do aluno, instrutor ou veículo." : "Recursos cadastrados, mas indisponíveis na data selecionada. Confira ativação, jornada, bloqueios e compatibilidade entre instrutor e veículo.");
}
const pedido = request => new Promise((resolve, reject) => { request.onsuccess = () => resolve(request.result); request.onerror = () => reject(request.error); });
const fim = tx => new Promise((resolve, reject) => { tx.oncomplete = resolve; tx.onabort = tx.onerror = () => reject(tx.error || new Error("Transação local interrompida.")); });
const bytes = texto => new TextEncoder().encode(texto);
const hex = buffer => Array.from(new Uint8Array(buffer), n => n.toString(16).padStart(2, "0")).join("");
async function derivar(senha, sal) {
    const chave = await crypto.subtle.importKey("raw", bytes(senha), "PBKDF2", false, ["deriveBits"]);
    return hex(await crypto.subtle.deriveBits({ name: "PBKDF2", salt: bytes(sal), iterations: 600000, hash: "SHA-256" }, chave, 256));
}
async function segredo(senha) {
    const sal = hex(crypto.getRandomValues(new Uint8Array(24)));
    return { sal, hash: await derivar(senha, sal) };
}
export async function criarServicoLocal() {
    function proteger() {
        if (ambienteAtual() !== "local") throw new Error("Ambiente local não autorizado.");
    }
    proteger();
    if (!globalThis.indexedDB || !crypto.subtle) throw new Error("Este navegador não oferece armazenamento e criptografia locais necessários.");
    const abertura = indexedDB.open("sipa.dev.local.v1", 2);
    abertura.onupgradeneeded = () => {
        for (const nome of ["contas", "sessoes", "registros", "creditos"]) {
            if (!abertura.result.objectStoreNames.contains(nome)) abertura.result.createObjectStore(nome, { keyPath: "id" });
        }
    };
    const db = await pedido(abertura);
    db.onversionchange = () => db.close();
    async function ler(store, id) {
        proteger(); const tx = db.transaction(store); const done = fim(tx);
        const valor = await pedido(tx.objectStore(store).get(id)); await done; return valor;
    }
    async function gravar(store, registro, inserir = false) {
        proteger(); const tx = db.transaction(store, "readwrite"), done = fim(tx);
        tx.objectStore(store)[inserir ? "add" : "put"](registro); await done;
    }
    async function sessao() {
        proteger(); const nonce = sessionStorage.getItem(CHAVE);
        if (!nonce) return null;
        const id = hex(await crypto.subtle.digest("SHA-256", bytes(nonce)));
        const registro = await ler("sessoes", id), conta = await ler("contas", "master");
        if (!registro || registro.expira <= Date.now() || !conta?.ativa || conta.provisoria) { sessionStorage.removeItem(CHAVE); return null; }
        return { perfil: "Master de desenvolvimento — Nível 5", identificador: conta.identificador, interface: registro.interface || null };
    }
    async function exigirSessao() { if (!await sessao()) throw new Error("Entre novamente no ambiente local."); }
    async function registros() {
        await exigirSessao(); const tx = db.transaction("registros"), done = fim(tx);
        const lista = await pedido(tx.objectStore("registros").getAll()); await done; return lista;
    }
    async function creditos() {
        await exigirSessao(); const tx = db.transaction("creditos"), done = fim(tx);
        const lista = await pedido(tx.objectStore("creditos").getAll()); await done; return lista;
    }
    function validarRegistros(lista) {
        if (!Array.isArray(lista) || lista.length > 10000) throw new Error("Backup inválido ou muito grande.");
        const ids = new Set(), unicos = new Set();
        const limpos = lista.map(item => {
            if (!item || !["aluno", "instrutor", "veiculo", "aula"].includes(item.tipo) || typeof item.id !== "string" || ids.has(item.id)) throw new Error("Registro ou identificador inválido/duplicado.");
            ids.add(item.id);
            const r = { ...structuredClone(item), id: item.id, tipo: item.tipo, nome: String(item.nome || "").trim(), unidade: String(item.unidade || "").trim() };
            if (!r.nome || r.nome.length > 120 || !r.unidade || r.unidade.length > 80) throw new Error("Informe nome e unidade válidos.");
            if (r.tipo !== "aula") {
                if (item.ativo != null && typeof item.ativo !== "boolean") throw new Error("Informe ativo como verdadeiro ou falso.");
                if (item.disponibilidadeSemanal != null) validarDisponibilidadeSemanal(item.disponibilidadeSemanal);
                if (item.disponivel != null && typeof item.disponivel !== "boolean") throw new Error("Disponibilidade inválida.");
