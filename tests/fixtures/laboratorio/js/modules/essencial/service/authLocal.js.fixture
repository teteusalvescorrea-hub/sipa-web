                if (item.categoria != null && !["A", "B"].includes(item.categoria)) throw new Error("Categoria de veículo inválida.");
                if (item.categorias != null && (!Array.isArray(item.categorias) || item.categorias.some(c => !["A", "B"].includes(c)))) throw new Error("Categorias de instrutor inválidas.");
                for (const chave of ["bloqueios", "bloqueiosUnidade"]) {
                    if (item[chave] != null && (!Array.isArray(item[chave]) || item[chave].some(b => !/^\d{4}-\d{2}-\d{2}$/.test(b.data) || (b.inicio && (!/^\d{2}:\d{2}$/.test(b.inicio) || !/^\d{2}:\d{2}$/.test(b.fim) || b.inicio >= b.fim))))) throw new Error("Bloqueio local inválido.");
                }
                if (item.feriadosUnidade != null && (!Array.isArray(item.feriadosUnidade) || item.feriadosUnidade.some(d => !/^\d{4}-\d{2}-\d{2}$/.test(d)))) throw new Error("Feriados da unidade inválidos.");
                r.documento = String(item.documento || "").replace(/[^a-z0-9]/gi, "").toUpperCase();
                if (!recursoFicticioGerado(r) && (r.tipo === "veiculo" ? !/^[A-Z0-9]{7}$/.test(r.documento) : !/^\d{11}$/.test(r.documento))) throw new Error("Informe CPF com 11 dígitos ou placa com 7 caracteres. Identificadores TST são exclusivos dos recursos fictícios preparados pelo sistema local.");
                const chave = `${r.tipo === "veiculo" ? "placa" : "cpf"}:${r.documento}`;
                if (unicos.has(chave)) throw new Error("CPF ou placa já cadastrados no laboratório.");
                unicos.add(chave);
            } else {
                for (const campo of ["aluno", "instrutor", "veiculo", "inicio", "fim"]) r[campo] = String(item[campo] || "");
                // Metadados opcionais: registros antigos sem essas informações
                // continuam preservados; não se atribui situação automaticamente.
                if (item.categoria != null) { if (!["A", "B"].includes(item.categoria)) throw new Error("Categoria inválida."); r.categoria = item.categoria; }
                if (item.status != null) { if (![1, 2, 3, 4, 5, 6].includes(item.status)) throw new Error("Situação da aula inválida."); r.status = item.status; }
                if (!Number.isFinite(Date.parse(r.inicio)) || !Number.isFinite(Date.parse(r.fim)) || Date.parse(r.fim) <= Date.parse(r.inicio)) throw new Error("Informe início e fim válidos para a aula.");
            }
            return r;
        });
        for (const aula of limpos.filter(r => r.tipo === "aula")) {
            for (const tipo of ["aluno", "instrutor", "veiculo"]) {
                if (!limpos.some(r => r.id === aula[tipo] && r.tipo === tipo && (tipo === "aluno" || normalizarUnidadeLocal(r.unidade) === normalizarUnidadeLocal(aula.unidade)))) throw new Error("O aluno deve existir e os recursos devem pertencer à unidade da aula.");
            }
            if (![2, 4].includes(aula.status) && limpos.some(r => r.tipo === "aula" && ![2, 4].includes(r.status) && r.id !== aula.id && Date.parse(r.inicio) < Date.parse(aula.fim) && Date.parse(aula.inicio) < Date.parse(r.fim) && ["aluno", "instrutor", "veiculo"].some(c => r[c] === aula[c]))) throw new Error("Há conflito de horário nos recursos da aula local.");
        }
        return limpos;
    }
    async function substituir(lista) {
        await exigirSessao(); const limpos = validarRegistros(lista);
        if ((await creditos()).some(c => !limpos.some(r => r.id === c.alunoId && r.tipo === "aluno"))) throw new Error("Há créditos vinculados a alunos existentes. Nenhum registro foi removido.");
        const tx = db.transaction("registros", "readwrite"), done = fim(tx), store = tx.objectStore("registros");
        store.clear(); limpos.forEach(r => store.add(r)); await done;
    }
    // Serializa alterações deste serviço; revisões simultâneas em outras abas são
    // bloqueadas por Web Locks, sem sobrescrever silenciosamente cadastros.
    async function alterar(fn) {
